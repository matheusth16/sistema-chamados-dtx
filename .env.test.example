# .env.test.example — Copie para .env.test e preencha com credenciais de teste
# NUNCA commite .env.test com valores reais

# URL do servidor Flask para testes E2E
# Local:  http://127.0.0.1:5000
# CI/CD:  configurar como secret FLASK_TEST_URL no GitHub
FLASK_TEST_URL=http://127.0.0.1:5000
# Ativa o servidor Flask local usado pelos E2E quando FLASK_TEST_URL não aponta
# para um ambiente externo. Valor seguro para desenvolvimento/CI.
FLASK_E2E_STUB=1

# Credenciais de teste por perfil
# Crie usuários de teste dedicados no ambiente de desenvolvimento/staging
# Não use credenciais de produção

# Contas e secrets abaixo são fixtures E2E públicas/fake, iguais ao workflow.
# Não reutilize estes valores em desenvolvimento compartilhado ou produção.
TEST_SOLICITANTE_EMAIL=e2e.solicitante@dtx.aero
TEST_SOLICITANTE_PASSWORD=E2eTeste2026!
TEST_SOLICITANTE_TOTP_SECRET=5KHQN27VBTA57XJBK5YR5NY4WGXBLVZ5

TEST_SUPERVISOR_EMAIL=e2e.supervisor@dtx.aero
TEST_SUPERVISOR_PASSWORD=E2eTeste2026!
TEST_SUPERVISOR_TOTP_SECRET=I3AK4NH2DG4XQIZTZAGPNNUYGZMNYKFM

TEST_ADMIN_EMAIL=e2e.admin@dtx.aero
TEST_ADMIN_PASSWORD=E2eTeste2026!
TEST_ADMIN_TOTP_SECRET=BTYKKDGWJZGP5Z3TLLPEHMQLQE7W6FMZ

# Usado apenas por tests/e2e/test_capture_onboarding_screenshots.py (captura de
# screenshots do onboarding). Aponte para o usuário admin_global criado por
# scripts/seed_dados_demo_onboarding.py (demo.admin.global@dtx.com).
TEST_ADMIN_GLOBAL_EMAIL=demo.admin.global@dtx.com
TEST_ADMIN_GLOBAL_PASSWORD=DemoOnboarding123!
