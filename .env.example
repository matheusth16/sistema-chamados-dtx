# Copie para .env e preencha os valores.
# cp .env.example .env

# === Aplicação ===
FLASK_APP=run.py
FLASK_ENV=development
# Obrigatório em produção: gere uma chave forte (ex: openssl rand -hex 32). Não use o valor de desenvolvimento.
SECRET_KEY=gere-uma-chave-secreta-forte-aqui
# URL base usada em links de e-mail e validação de Origin. Em produção deve ser https://.
APP_BASE_URL=http://localhost:5000

# === PostgreSQL (banco da aplicação, obrigatório) ===
# String de conexão do Postgres de produção/dev. A app não sobe sem isso —
# init_engine() em app/db/__init__.py fica no-op sem DATABASE_URL, e toda
# rota que toca dado (login incluso) quebra com SessionLocal=None.
DATABASE_URL=postgresql://user:senha@localhost:5432/sistema_chamados_dev

# === PostgreSQL de teste (usado só pela suíte pytest) ===
# Fixture db_engine/db_session (tests/conftest.py) roda contra um banco
# Postgres real, não mock. No CI, o valor abaixo é setado automaticamente
# (serviço postgres:16-alpine, ver .github/workflows/ci.yml). Em dev local,
# use um banco SEPARADO do DATABASE_URL acima (pytest recria/limpa schema).
TEST_DATABASE_URL=postgresql://postgres:SENHA_LOCAL@localhost:5432/sistema_chamados_test

# === Cloudflare R2 (storage de anexos legados, lidos mas não mais escritos) ===
# Anexos novos vão pro disco local (ANEXO_STORAGE_BACKEND=local, abaixo) —
# R2 só é usado pra servir anexos antigos que já estavam lá antes da Fase 1.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# === Armazenamento local de anexos novos (Fase 1 on-premise) ===
# ANEXO_STORAGE_BACKEND=local faz uploads NOVOS irem para disco local primeiro
# (R2 vira fallback se o disco falhar — Firebase Storage não é mais uma opção
# viável, ver nota acima). Anexos antigos continuam lidos normalmente do R2.
# ANEXO_LOCAL_DIR deve apontar para um bind-mount fora do container em produção
# (ex.: /var/anexos_chamados no HD dedicado do servidor físico).
# ANEXO_STORAGE_BACKEND=local
# ANEXO_LOCAL_DIR=/var/anexos_chamados

# === E-mail via Microsoft Graph API ===
# Requer app registration no Azure AD com permissão Mail.Send (Application).
# Tenant ID e Client ID: Azure > App Registrations > Overview.
# Client Secret: App Registrations > Certificates & secrets > Client secrets
#   ⚠️  Use o campo "Value" (ex: dad8Q~...), NÃO o "Secret ID" (UUID).
GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_SECRET=seu-client-secret-value-aqui
GRAPH_SENDER_EMAIL=xxxxxx.xxxxxx@xxx.xxx

# === Entrar com Microsoft (SSO, Authorization Code + PKCE) ===
# Por padrão reaproveita GRAPH_TENANT_ID/GRAPH_CLIENT_ID/GRAPH_CLIENT_SECRET (mesmo App
# Registration). Só preencha as 3 abaixo se for usar um App Registration separado.
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_TENANT_ID=
SSO_REDIRECT_URI=http://localhost:5000/login/microsoft/callback
# SSO_MICROSOFT_ENABLED=true

# Envio global de e-mails transacionais via Graph API.
# false em dev/testes locais (padrão fora de produção); true só em produção ou quando quiser testar envio real.
# NOTIFY_EMAIL_ENABLED=false

# === Web Push (notificações no navegador) ===
# Gere com: python scripts/gerar_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# === Criptografia em repouso (LGPD — Onda 4) ===
# Criptografia Fernet dos campos PII 'nome' e 'email' no Postgres (CWI 2.3).
# Já parte do schema (coluna email_lookup_hash com índice único, ver
# alembic/versions/552599f9b52c_usuarios.py) — não precisa de migração manual
# em instalação nova. Default: ENCRYPT_PII_AT_REST=false (boot seguro sem
# config extra); ative manualmente em produção real.
#
# Gere a chave:  python scripts/gerar_chave_criptografia.py
# Em produção com ENCRYPT_PII_AT_REST=true: a app não sobe sem ENCRYPTION_KEY válida.
# Ver ADR: docs/adr/001-criptografia-pii-fernet.md
#
# ENCRYPTION_KEY=
# ENCRYPT_PII_AT_REST=false

# === Rate Limiting (relatórios e export) ===
# 0 = desativado. Recomendado em produção: 10.
# RELATORIO_MAX_POR_USUARIO_POR_DIA=10
# EXPORT_EXCEL_MAX_POR_USUARIO_POR_DIA=10

# === Cache e Rate Limiting HTTP (opcional) ===
# Se definido: cache de relatórios e rate limiting compartilhado entre workers (recomendado em produção).
# Senão: cache e rate limit em memória por processo.
# REDIS_URL=redis://localhost:6379/0

# === Tradução (opcional) ===
# Aumenta o limite da MyMemory API de 5k para 10k chars/dia.
# Cadastre-se em mymemory.translated.net
# MYMEMORY_EMAIL=seu@email.com

# LibreTranslate self-hosted — tradução automática de descrição/histórico/
# conversa dos chamados (ver docker-compose.yml, serviço "libretranslate").
# Desligado por padrão; suba o container antes de habilitar.
# LIBRETRANSLATE_ENABLED=true
# LIBRETRANSLATE_URL=http://libretranslate:5000
# LIBRETRANSLATE_TIMEOUT_SECONDS=15

# === Logging (opcional) ===
# Nível: DEBUG, INFO, WARNING, ERROR. Em produção use INFO ou WARNING.
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=2097152
# LOG_BACKUP_COUNT=5

# === Segurança (produção) ===
SESSION_COOKIE_SECURE=False

# ⚠️  OBRIGATÓRIO EM PRODUÇÃO (a aplicação não sobe sem estas vars quando FLASK_ENV=production)
# Token para proteger /health?deep=1 (expõe status de Postgres e Redis).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Mínimo 16 caracteres. (ver ADR: docs/adr/003-fail-fast-config-producao.md)
#
# Canal primário (recomendado — não aparece em access logs):
#   curl -H "X-Health-Token: <valor>" "https://host/health?deep=1"
#
# HEALTH_SECRET=

# === Workers e Redis ===
# Número de workers Gunicorn. Padrão: 1 (cenário DTX atual — 1 worker, 8 threads gthread).
# Se GUNICORN_WORKERS > 1, REDIS_URL torna-se obrigatória (rate limit compartilhado).
# GUNICORN_WORKERS=1

# Se true, força fail-fast na boot se REDIS_URL não estiver definida (opt-in explícito).
# REQUIRE_REDIS=false

# === Proteção de ambiente staging/HML (CWI 4.1 — camada 2 fallback) ===
# Ativa HTTP Basic Auth quando ENV != production e TESTING != True.
# Camada primária: VPN / firewall de rede (ver docs/adr/002-protecao-ambientes-staging.md).
# NÃO ativar em produção: STAGING_AUTH_ENABLED é ignorado quando ENV=production.
# NÃO ativar em desenvolvimento sem HTTPS configurado (Basic Auth transmite em Base64).
# Rotas excluídas automaticamente: /health, /login, /sw.js, /internal/cron/sla-escalacao
#
# Gere credenciais fortes:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# STAGING_AUTH_ENABLED=true
# STAGING_AUTH_USER=hml_user
# STAGING_AUTH_PASSWORD=gere-senha-forte-aqui

# === Watchtower (deploy manual — servidor físico) ===
# Token da HTTP API do Watchtower (docker-compose.prod.yml). Deploy só acontece
# quando alguém dispara a API explicitamente (ver scripts/watchtower_trigger.sh)
# — o container NÃO atualiza sozinho quando o CI publica imagem nova.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WATCHTOWER_HTTP_API_TOKEN=

# === Postgres (servidor físico — docker-compose.prod.yml) ===
# Senha do serviço "postgres" no compose de produção. Só relevante rodando
# via docker-compose.prod.yml — não é lida pela app Python diretamente
# (a app usa DATABASE_URL, que já embute usuário/senha/host).
# POSTGRES_PASSWORD=

# === Cron interno (rota /internal/cron/sla-escalacao) ===
# Autentica requisições via header X-Cron-Token. O disparo automático hoje é
# via APScheduler in-process (app/__init__.py), não por chamada HTTP externa
# — só precisa disso se for testar/disparar a rota manualmente.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRON_SECRET=

# === SLA / Escalonamento ===
# Janela de tempo útil DTX (seg–sex, pausa almoço)
# SLA_HORARIO_INICIO=07:00
# SLA_HORARIO_FIM=16:30
# SLA_ALMOCO_INICIO=11:30
# SLA_ALMOCO_FIM=13:00
# Prazo de resolução por categoria (dias úteis)
# SLA_DIAS_RESOLUCAO_PROJETOS=2
# SLA_DIAS_RESOLUCAO_PADRAO=3
# Prazo de resolução de AOG, em minutos corridos (calendário, 24/7 — não usa horário útil)
# SLA_AOG_MINUTOS_RESOLUCAO_DEADLINE=240
# Incluir sábado/domingo no cálculo de tempo útil (false = excluir, v1)
# SLA_INCLUI_FIM_DE_SEMANA=false
# Timezone para cálculos SLA (IANA tz name)
# SLA_TIMEZONE=America/Sao_Paulo
# E-mails dos gestores por nível (escalada gerencial): não é mais configurável por
# variável de ambiente. Cadastre o Nível de Gestão (Gestor de Setor / Gerente de
# Produção / Assistente GM / GM) direto no usuário em /admin/usuarios — o
# escalonamento e o broadcast de AOG buscam o e-mail de lá automaticamente.
